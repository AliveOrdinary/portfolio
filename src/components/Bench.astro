---
// A demo laid out like the FAQ card: a thin bordered card, a "TRY IT:" label and
// the title on a ruled header row, a sentence saying what to try, then the demo
// on the drawing grid.
interface Props { title: string; id?: string; }
const { title, id } = Astro.props;
---

<section class="bench" aria-labelledby={id ? `${id}-title` : undefined} id={id}>
  <div class="bench-head">
    <span class="bench-tag" aria-hidden="true">Try it:</span>
    <h3 id={id ? `${id}-title` : undefined}>{title}</h3>
  </div>
  <div class="bench-intro"><slot name="intro" /></div>
  <div class="bench-body"><slot /></div>
</section>

<style>
  .bench { border: 1px solid rgba(0, 0, 0, 0.1); border-radius: 4px; background: var(--paper); }
  .bench-head {
    display: flex; align-items: baseline; gap: 0.9rem; flex-wrap: wrap;
    padding: 1rem clamp(1rem, 3vw, 1.75rem); border-bottom: 1px solid var(--hairline);
  }
  .bench-tag { font-family: var(--mono); font-size: var(--m-label); text-transform: uppercase; color: var(--blue); }
  .bench-head h3 { font-family: var(--mono); font-weight: 400; font-size: var(--m-head); text-transform: uppercase; }
  .bench-intro { padding: 1.25rem clamp(1rem, 3vw, 1.75rem) 0; }
  .bench-intro :global(p) { font-size: var(--t-sm); max-width: 44rem; }
  .bench-body {
    padding: 1.5rem clamp(1rem, 3vw, 1.75rem) clamp(1.25rem, 3vw, 2rem);
    background-image: radial-gradient(circle, rgba(16, 61, 255, 0.12) 1px, transparent 1.25px);
    background-size: 16px 16px;
  }
</style>
