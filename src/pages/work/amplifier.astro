---
import { Image } from 'astro:assets';
import Case from '../../layouts/Case.astro';
import Figure from '../../components/Figure.astro';
import FigPair from '../../components/figures/FigPair.astro';
import Bench from '../../components/Bench.astro';
import Stats from '../../components/Stats.astro';
import Journey from '../../components/Journey.astro';
import ThisOrThat from '../../components/demos/ThisOrThat.astro';

import prepHeadline from '../../assets/amplifier/v2/studio/06-prep-headline-contradictions.png';
import prepProfile from '../../assets/amplifier/v2/studio/07-prep-taste-profile.png';
import prepHesitations from '../../assets/amplifier/v2/studio/08-prep-hesitations-moodboard.png';
import earlyRead from '../../assets/amplifier/v2/studio/05-brief-link-and-early-read.png';
import libScores from '../../assets/amplifier/v2/studio/01-library-scores.png';
import libSimilar from '../../assets/amplifier/v2/studio/02-library-more-like-this.png';
import libCoverage from '../../assets/amplifier/v2/studio/03-library-coverage.png';
import rubric from '../../assets/amplifier/v2/studio/04-settings-rubric.png';
import pWelcome from '../../assets/amplifier/v2/phone/01-welcome.png';
import pQuestion from '../../assets/amplifier/v2/phone/02-first-question.png';
import pSwipe from '../../assets/amplifier/v2/phone/03-warmup-swipe.png';

const spec = [
  { label: 'For', value: 'Amplifier, the small design studio I’m a partner in' },
  { label: 'My role', value: 'Research, design and build' },
  { label: 'When', value: 'Rebuilt October 2026 (first version 2025)' },
  { label: 'Used by', value: 'Our three designers; clients on their phones, through a private link' },
  { label: 'Status', value: 'In testing with the studio, using test briefs' },
  { label: 'Built with', value: 'Next.js 16, Supabase (Postgres, row-level security, pgvector), Claude Sonnet, Voyage multimodal embeddings' },
];

const phones = [
  { src: pWelcome, alt: 'Brief on a phone: “Hi Maya.” with a short welcome and a note from the studio, and a Start button.' },
  { src: pQuestion, alt: 'Brief on a phone: “What are you making, and who is it for?” with the client’s answer typed in.' },
  { src: pSwipe, alt: 'Brief on a phone: “Keep or skip?”, warm-up image 4 of 12, with Skip and Keep buttons.' },
];

const chapters = [
  { id: 'problem', title: 'The problem' },
  { id: 'pairs', title: 'Which feels closer?' },
  { id: 'brief', title: 'The brief' },
  { id: 'prep', title: 'The prep page' },
  { id: 'library', title: 'The library' },
  { id: 'decisions', title: 'Decisions' },
  { id: 'now', title: 'Where it is now' },
  { id: 'next', title: 'What I’d change next' },
  { id: 'reflection', title: 'Reflection' },
];
const n = (id: string) => `CH_${String(chapters.findIndex((c) => c.id === id) + 1).padStart(2, '0')}`;

const stations = [
  {
    name: 'Private link',
    who: 'The studio sends it; the client opens it',
    before: 'A client questionnaire, turned into keywords.',
    now: 'A private link that expires after 30 days. No account, no app.',
    where: 'The client’s phone',
  },
  {
    name: 'Welcome and one question',
    who: 'The client',
    before: 'A few adjectives in a questionnaire.',
    now: 'A short personal note from the studio, then one question in words: what are you making, and who is it for?',
    where: 'The client’s phone',
  },
  {
    name: 'Warm-up',
    who: 'The client',
    before: 'The brief could only match the words a client typed.',
    now: 'Twelve images to keep or skip. Answers save in the background, so swipes feel instant.',
    where: 'The client’s phone',
  },
  {
    name: 'This or that',
    who: 'The client',
    before: 'Keywords matched against tags nobody kept up.',
    now: 'About twenty pairs, each aimed at the dimension the system is least sure about, using two images close on everything else. A few come back with the sides swapped to check the answer holds.',
    where: 'The client’s phone',
  },
  {
    name: 'Early read',
    who: 'The studio',
    before: 'Keywords from the questionnaire.',
    now: 'As soon as the client finishes: where each choice leans, how unsure it still is, and how many repeated pairs got the same answer.',
    where: 'The studio’s brief page',
  },
  {
    name: 'First meeting',
    who: 'The studio and the client',
    before: 'A few adjectives and a guess.',
    now: 'The prep page, screen-shared: a headline, contradictions with a question to ask, the taste profile, hesitations and a starter moodboard.',
    where: 'The first meeting',
  },
];
---

<Case
  title="Amplifier: reference library and visual brief by Navaneeth Krishnan"
  name="Amplifier"
  summary="A reference library Claude scores, and a visual brief that finds what a client actually likes, not just what they say."
  description="How I rebuilt Amplifier: a design reference library scored against a rubric, an adaptive this-or-that brief for clients, and a prep page for the first meeting."
  spec={spec}
  chapters={chapters}
  next={{ href: '/work/613-automotive', name: '613 Automotive' }}
>
  <Figure n={1} name="This or that" year="2026" slot="figure">
    <FigPair />
  </Figure>

  <section class="chapter" id="problem">
    <span class="chapter-n">{n('problem')}</span>
    <h2>The problem</h2>
    <p class="insight">“Minimal” can turn out to mean calm rather than empty.</p>
    <div class="prose">
      <p class="dropcap">
        Clients usually know what they like when they see it, but the words they use for it can point somewhere
        else. The first meeting is where that gets untangled, and we were walking in with a few adjectives and a
        guess.
      </p>
      <p>
        The 2025 version of Amplifier tagged our reference library and turned a client questionnaire into keywords.
        It worked, but creating and maintaining tags was a chore, so nobody kept them up, and the brief could only
        match the words a client typed. In October 2026 I rebuilt it from scratch around two ideas: describe the
        library with definitions instead of tags, and learn what a client likes from what they choose.
      </p>
    </div>
    <Stats items={[
      { value: '~8 min', label: 'For a client to finish the brief on a phone' },
      { value: '~20', label: 'This-or-that pairs, each aimed at what it’s least sure of' },
      { value: '91–95%', label: 'Right side of each dimension, with simulated clients' },
      { value: '30 days', label: 'Before a client’s private link expires' },
    ]} />
    <figure>
      <Image src={prepHeadline} alt="Prep page for a test brief: a one-paragraph headline about what the client asked for and what they chose, stats for the session, and three contradictions, each with a question to ask." widths={[800, 1400, 2000]} sizes="(min-width: 60rem) 60rem, 100vw" class="shot" />
      <figcaption>The prep page for a test brief: what the client said, what they chose, and what to ask in the first meeting. The client and project are made up.</figcaption>
    </figure>
  </section>

  <section class="chapter" id="pairs">
    <span class="chapter-n">{n('pairs')}</span>
    <h2>Which feels closer?</h2>
    <p class="insight">Each pair changes one thing and keeps the rest the same.</p>
    <Bench title="Which feels closer?" id="pair-demo">
      <p slot="intro">
        A small version of the brief. Say what you want in words, then pick between eight pairs. The next pair goes
        after whatever it’s least sure about. The images here are shapes drawn from numbers; the real brief uses the
        studio’s library.
      </p>
      <ThisOrThat />
    </Bench>
  </section>

  <section class="chapter" id="brief">
    <span class="chapter-n">{n('brief')}</span>
    <h2>The brief</h2>
    <p class="insight">About eight minutes on a phone. No account, no app.</p>
    <Journey id="brief-journey" title="One brief, link to first meeting: pick a station" stations={stations} />
    <div class="prose">
      <p>
        Now and then a quick “what caught your eye?” offers a few chips to tap, and the remaining questions in words
        come at the end, then a thank-you with the meeting date. I tested the engine with simulated clients before
        any real one saw it. With a library of 100+ images, it picks the right side of each dimension 91–95% of
        the time.
      </p>
    </div>
    <div class="phones">
      {phones.map((p) => (
        <Image src={p.src} alt={p.alt} widths={[320, 520]} sizes="(min-width: 60rem) 15rem, 32vw" />
      ))}
    </div>
    <figure>
      <Image src={earlyRead} alt="Brief page in the studio: the private link (blurred), dates, and an early read showing where each dimension leans with a band for how unsure it is, and “2 of 3 repeated pairs got the same answer”." widths={[800, 1400, 2000]} sizes="(min-width: 60rem) 60rem, 100vw" class="shot" />
      <figcaption>The studio sees an early read as soon as the client finishes: where each choice leans, how unsure it still is, and how many repeated pairs got the same answer.</figcaption>
    </figure>
  </section>

  <section class="chapter" id="prep">
    <span class="chapter-n">{n('prep')}</span>
    <h2>The prep page</h2>
    <p class="insight">Made to be screen-shared in the first meeting.</p>
    <div class="prose">
      <p>When the client finishes, the prep page builds itself.</p>
      <ul>
        <li><strong>A headline:</strong> one paragraph on what they asked for, what they chose, and what to ask.</li>
        <li><strong>Contradictions,</strong> picked by the numbers: only where what they said and what they chose differ enough, with enough confidence. Claude writes the wording and a question to ask, and the studio can edit it or regenerate it.</li>
        <li><strong>Taste profile:</strong> what they said against what they showed on every dimension, plus the directions they consistently chose or passed over, with examples.</li>
        <li><strong>Hesitations:</strong> their slowest picks, and any answer that changed when a pair came back swapped.</li>
        <li><strong>A starter moodboard</strong> from their picks and close matches. “Copy as layers” pastes it into Figma as separate layers, and images dropped onto the board go into the library too.</li>
      </ul>
    </div>
    <div class="shots shots-2">
      <figure>
        <Image src={prepProfile} alt="Taste profile: for each dimension, a hollow dot for what the client said and a filled dot for what they chose, with gaps highlighted; below, confident directions with thumbnails." widths={[640, 1000, 1400]} sizes="(min-width: 60rem) 30rem, 100vw" />
        <figcaption>Said against showed, on every dimension of the rubric.</figcaption>
      </figure>
      <figure>
        <Image src={prepHesitations} alt="Hesitations listing the slowest pairs and a changed answer, and a starter moodboard with Copy as layers, Download images and Add from library." widths={[640, 1000, 1400]} sizes="(min-width: 60rem) 30rem, 100vw" />
        <figcaption>Where they hesitated, and a moodboard ready to paste into Figma.</figcaption>
      </figure>
    </div>
  </section>

  <section class="chapter" id="library">
    <span class="chapter-n">{n('library')}</span>
    <h2>The library</h2>
    <p class="insight">Instead of tags, the studio writes a rubric.</p>
    <div class="prose">
      <p>
        Up to ten dimensions, each a spectrum between two ends, and each end described by what you can see, like
        elements, colour, line and texture. Claude scores every image on every dimension.
      </p>
      <ul>
        <li><strong>Anchors:</strong> library images pinned as examples of an end. Claude sees them every time it scores.</li>
        <li><strong>Corrections</strong> are recorded and fed back into scoring. A designer’s edits are kept when an image is rescored, and changing a definition marks the old scores stale and offers a rescore.</li>
        <li><strong>Embeddings</strong> (Voyage multimodal, stored in Postgres with pgvector) power “More like this” and catch near-duplicates on upload, alongside exact hash matching.</li>
        <li><strong>Coverage</strong> shows which ends of which dimensions need more images, because the brief needs every end filled.</li>
      </ul>
    </div>
    <div class="shots shots-2">
      <figure>
        <Image src={libScores} alt="Library grid with one image open: Claude’s description, its medium, and eight scores on spectrums such as Minimal to Rich and Quiet to Loud." widths={[640, 1000, 1400]} sizes="(min-width: 60rem) 30rem, 100vw" />
        <figcaption>Every image scored on every dimension. Designer edits survive a rescore.</figcaption>
      </figure>
      <figure>
        <Image src={rubric} alt="Rubric settings: each dimension with a left and right end, each end described by what you can see, slots for anchor images, and a count of corrections." widths={[640, 1000, 1400]} sizes="(min-width: 60rem) 30rem, 100vw" />
        <figcaption>The rubric: each end defined by what you can see.</figcaption>
      </figure>
      <figure>
        <Image src={libSimilar} alt="More like this: twenty library images ordered by similarity to the selected one." widths={[640, 1000, 1400]} sizes="(min-width: 60rem) 30rem, 100vw" />
        <figcaption>“More like this”, closest first, from image embeddings.</figcaption>
      </figure>
      <figure>
        <Image src={libCoverage} alt="Coverage: histograms of how approved images spread across each dimension, with thin ends flagged, and a count of images per medium." widths={[640, 1000, 1400]} sizes="(min-width: 60rem) 30rem, 100vw" />
        <figcaption>Coverage: which ends need more images.</figcaption>
      </figure>
    </div>
    <p class="credit">Library images are saved references by other designers, shown as they appear inside the studio’s tool.</p>
  </section>

  <section class="chapter" id="decisions">
    <span class="chapter-n">{n('decisions')}</span>
    <h2>Decisions</h2>
    <div class="decisions">
      <div class="decision">
        <h3>Definitions instead of a tag vocabulary</h3>
        <p>The first version’s tags were never maintained because creating them was a chore. A rubric is a handful of definitions the studio writes once. Claude does the scoring, and anchors and corrections keep it close to the studio’s eye.</p>
      </div>
      <div class="decision">
        <h3>A deterministic engine, tested before any client</h3>
        <p>Choosing the next pair, tracking how sure it is and checking consistency are plain code, not a model. That meant I could run simulated clients through it and know it worked before a real client ever saw it.</p>
      </div>
      <div class="decision">
        <h3>Numbers pick the contradictions; the model words them</h3>
        <p>A contradiction only appears when the gap between what was said and what was chosen is big enough and the data confident enough. Claude writes the sentence and the question, so it can’t invent a contradiction that isn’t there.</p>
      </div>
      <div class="decision">
        <h3>Embeddings from thumbnails, in batches</h3>
        <p>Similarity and duplicate checks run on embeddings made from thumbnails, sent in batches, so the cost stays low as the library grows.</p>
      </div>
      <div class="decision">
        <h3>A private link per client, not a public form</h3>
        <p>Each client gets their own link that expires after 30 days. Clients never need an account, and there’s no open form for strangers to find or fill with spam.</p>
      </div>
    </div>
  </section>

  <section class="chapter" id="now">
    <span class="chapter-n">{n('now')}</span>
    <h2>Where it is now</h2>
    <dl class="outcome">
      <div class="field"><dt>Status</dt><dd>Rebuilt October 2026, in testing with the studio using test briefs</dd></div>
      <div class="field"><dt>Tested</dt><dd>Right side of each dimension 91–95% of the time, with simulated clients and 100+ images</dd></div>
      <div class="field"><dt>Next</dt><dd>The first real client briefs</dd></div>
    </dl>
  </section>

  <section class="chapter" id="next">
    <span class="chapter-n">{n('next')}</span>
    <h2>What I’d change next</h2>
    <p class="draft-note">Draft: rewrite before publishing</p>
    <div class="prose">
      <p>
        <strong>Run the first real briefs.</strong> The engine passed simulated clients. Real ones will hesitate,
        skip and change their minds in ways a simulation doesn’t, so I’d compare each prep page’s contradictions
        with what actually came up in the meeting.
      </p>
      <p>
        <strong>Fill the thin ends.</strong> Coverage already shows which ends of which dimensions need more images.
        Closing those gaps is what lets the brief ask a fair question on every dimension.
      </p>
    </div>
  </section>

  <section class="chapter" id="reflection">
    <span class="chapter-n">{n('reflection')}</span>
    <h2>Reflection</h2>
    <p class="draft-note">Draft: rewrite before publishing</p>
    <div class="prose">
      <p>
        The first version taught me that a tag vocabulary nobody maintains is worse than none. The rebuild puts the
        studio’s effort in the one place it pays off, writing definitions, and leaves the repetitive scoring to
        Claude, kept honest by anchors, corrections and an engine I could test before anyone used it.
      </p>
    </div>
  </section>
</Case>

<style>
  .phones { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(0.75rem, 2vw, 1.5rem); max-width: 48rem; align-items: start; }
  .phones :global(img) { border: 1px solid var(--hairline); border-radius: 0; width: 100%; }
  .credit { font-family: var(--mono); font-size: var(--m-cap); text-transform: uppercase; color: var(--ash); margin-top: 1rem; }
</style>
