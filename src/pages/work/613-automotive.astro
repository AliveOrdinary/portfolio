---
import { Image } from 'astro:assets';
import Case from '../../layouts/Case.astro';
import Figure from '../../components/Figure.astro';
import FigDocs from '../../components/figures/FigDocs.astro';
import Bench from '../../components/Bench.astro';
import Stats from '../../components/Stats.astro';
import Journey from '../../components/Journey.astro';
import ShotSlot from '../../components/ShotSlot.astro';
import EstimateBuilder from '../../components/demos/EstimateBuilder.astro';

import jobHeader from '../../assets/613/desktop/07-job-header.png';
import vin from '../../assets/613/desktop/04-add-vehicle-vin-lookup.png';
import dropoff from '../../assets/613/desktop/10-vehicle-at-drop-off.png';
import approve from '../../assets/613/desktop/11-approve-estimate.png';
import invoice from '../../assets/613/desktop/12-create-invoice.png';
import payment from '../../assets/613/desktop/13-record-payment.png';
import pLines from '../../assets/613/phone/02-job-jump-bar.png';
import pPhotos from '../../assets/613/phone/03-photos.png';
import pInspect from '../../assets/613/phone/04-inspection.png';
import pQc from '../../assets/613/phone/05-quality-check.png';
import pDocs from '../../assets/613/phone/06-documents-sheet.png';
import dEstimate from '../../assets/613/documents/01-estimate.png';
import dWork from '../../assets/613/documents/02-work-order-page-1.png';
import dInvoice from '../../assets/613/documents/03-invoice.png';
import dInspect from '../../assets/613/documents/04-inspection-page-1.png';

const spec = [
  { label: 'For', value: '613 Automotive, Kingston, Ontario' },
  { label: 'My role', value: 'Everything: research, brand, app, printed documents' },
  { label: 'When', value: 'October to November 2026' },
  { label: 'Used by', value: 'The front desk on a computer, technicians on phones in the bay' },
  { label: 'Status', value: 'In live testing at the shop, changing with their feedback' },
  { label: 'Built with', value: 'Next.js 16, React 19, Supabase, jsPDF, Tailwind 4, Vitest' },
];

const docs = [
  { src: dEstimate, alt: 'Printed estimate EST-214 with customer, vehicle, eight repair lines and the insurance split.', caption: 'Estimate' },
  { src: dWork, alt: 'Printed work order RO-214, page one.', caption: 'Work order' },
  { src: dInvoice, alt: 'Printed invoice INV-214 with odometer in and out, payments and balance.', caption: 'Invoice' },
  { src: dInspect, alt: 'Printed mechanical inspection with OK, attention and urgent results per item.', caption: 'Inspection' },
];
const phones = [
  { src: pLines, alt: 'Job on a phone: section chips to jump between parts of the job, line items, and the total pinned to the bottom.' },
  { src: pPhotos, alt: 'Photos and files on a phone, tagged as drop-off, during repair or completed.' },
  { src: pInspect, alt: 'Brake inspection on a phone: OK, attention, urgent or N/A per item, with a note on urgent ones.' },
  { src: pQc, alt: 'Final quality check on a phone, ten items ticked.' },
  { src: pDocs, alt: 'Invoice sheet on a phone: open to print, download PDF, or share.' },
];

const chapters = [
  { id: 'shop', title: 'The shop' },
  { id: 'estimate', title: 'Build an estimate' },
  { id: 'job', title: 'A job, check-in to paid' },
  { id: 'quick', title: 'Quick sale' },
  { id: 'bay', title: 'On a phone in the bay' },
  { id: 'documents', title: 'Four documents' },
  { id: 'feedback', title: 'What changed after feedback' },
  { id: 'decisions', title: 'Decisions' },
  { id: 'now', title: 'Where it is now' },
  { id: 'reflection', title: 'Reflection' },
];
const n = (id: string) => `CH_${String(chapters.findIndex((c) => c.id === id) + 1).padStart(2, '0')}`;

const stations = [
  {
    name: 'Check-in',
    who: 'The front desk',
    before: 'No real paperwork.',
    now: 'One screen: search by plate, name or phone, and tapping a car picks the customer too. A new car’s VIN fills in the year, make, model and engine from NHTSA. Odometer and the customer’s concern go on the same screen, and one button saves it all.',
    where: 'Front desk, on a computer',
  },
  {
    name: 'Estimate',
    who: 'The front desk',
    before: 'Sample estimates made in ChatGPT, totals worked out on a calculator.',
    now: 'Lines by type, each with its own rate; parts marked new or used and OEM or aftermarket; the insurer’s estimate attached as a PDF. Common work is a one-tap saved item, and the car’s last job can be copied at today’s rates.',
    where: 'Front desk, on a computer',
  },
  {
    name: 'Drop-off',
    who: 'The front desk, with a phone',
    before: 'Nothing on record if a customer questions a scratch later.',
    now: 'Existing damage, warning lights, belongings, and photos taken on a phone. Mostly taps instead of typing.',
    where: 'At drop-off',
  },
  {
    name: 'Approval',
    who: 'The customer and the front desk',
    before: 'Not recorded, though Ontario requires it.',
    now: 'How the customer approved (signed the estimate, by phone, and so on) is recorded, and the work order is created.',
    where: 'Front desk',
  },
  {
    name: 'In the bay',
    who: 'Technicians',
    before: 'No real paperwork.',
    now: 'A 46-item mechanical inspection and a final quality check, filled in on a phone.',
    where: 'In the bay, on a phone',
  },
  {
    name: 'Invoice and payment',
    who: 'The front desk',
    before: 'Totals worked out on a calculator.',
    now: 'The invoice locks the lines so the printed copy always matches. “Paid now” records the payment in the same step, and payments can be split between customer and insurer.',
    where: 'Front desk',
  },
];
---

<Case
  title="613 Automotive: shop app by Navaneeth Krishnan"
  name="613 Automotive"
  summary="Estimates, work orders, inspections and invoices for a collision, paint and mechanical shop."
  description="How I built 613 Automotive's shop app: a job from estimate to paid, four printed documents, and inspections on a phone in the bay."
  spec={spec}
  chapters={chapters}
  next={{ href: '/work/sortlog', name: 'Sortlog' }}
>
  <Figure n={1} name="One job, three papers" year="2026" slot="figure">
    <FigDocs />
  </Figure>

  <section class="chapter" id="shop">
    <span class="chapter-n">{n('shop')}</span>
    <h2>The shop</h2>
    <p class="insight">They asked for an invoice generator. What they needed was the whole life of a job.</p>
    <div class="split">
      <div class="prose">
        <p class="dropcap">
          613 Automotive does collision repair, refinishing and mechanical work. When I started, they had no real
          paperwork: a few sample estimates someone had made in ChatGPT, totals worked out on a calculator, and a
          logo as a single JPEG.
        </p>
        <p>
          Their jobs aren’t simple invoices. Body, paint and mechanical labour are billed at different hourly rates.
          Paint materials carry a markup. Insurance jobs arrive with the insurer’s own estimate, and the bill is split
          between the insurer and the customer’s deductible. Customers sign on paper.
        </p>
        <p>
          So the app covers a job from the first estimate to the last payment, in one place, with paperwork they can
          hand to a customer without apologising for it.
        </p>
      </div>
      <figure>
        <Image src={jobHeader} alt="A job in the 613 app: RO-214, approved, with the progress bar from estimate to paid, the three documents, section chips, customer and vehicle, and the totals." widths={[640, 1000, 1400]} sizes="(min-width: 60rem) 26rem, 100vw" class="shot" />
        <figcaption>A job, and where it is: estimate, approved, ready, invoiced, paid. Every customer and vehicle in these screens is made up.</figcaption>
      </figure>
    </div>
    <Stats items={[
      { value: '4', label: 'Printed documents from one job' },
      { value: '46', label: 'Items in the mechanical inspection' },
      { value: '10%', label: 'Ontario’s cap over an approved estimate' },
      { value: '1', label: 'Module works out every total, in whole cents' },
    ]} />
  </section>

  <section class="chapter" id="estimate">
    <span class="chapter-n">{n('estimate')}</span>
    <h2>Build an estimate</h2>
    <p class="insight">Money is worked out in one place.</p>
    <Bench title="Build an estimate" id="estimate-demo">
      <p slot="intro">
        This is the shop’s sample collision job. Change hours, prices or line types and the totals work themselves
        out the way the app does it. Then approve the estimate and push a line up: Ontario caps the final bill at
        10% over an approved estimate.
      </p>
      <EstimateBuilder />
    </Bench>
  </section>

  <section class="chapter" id="job">
    <span class="chapter-n">{n('job')}</span>
    <h2>A job, check-in to paid</h2>
    <p class="insight">A job follows the order the shop already works in.</p>
    <Journey id="job-journey" title="One job: pick a station" stations={stations} />
    <div class="shots shots-3">
      <ShotSlot
        file="613/desktop/01-check-in.png"
        alt="Check-in on one screen: the customer picked, their car chosen, odometer in and what the customer wants done, and a Create estimate button."
        caption="Check-in: customer, car and job in one save."
        sizes="(min-width: 60rem) 20rem, 50vw"
      />
      <ShotSlot
        file="613/desktop/02-saved-items.png"
        alt="An estimate’s line items with three lines just added from the Front brake pads and rotors saved item and an Undo, the row of saved-item buttons, and a link to copy the lines from this car’s last invoice."
        caption="Saved items and the car’s last job, one tap each, with undo."
        sizes="(min-width: 60rem) 20rem, 50vw"
      />
      <figure>
        <Image src={vin} alt="Adding a vehicle: the VIN field says the VIN looks right and shows the decoded 2022 Hyundai Tucson Preferred, with the fields filled in." widths={[480, 800]} sizes="(min-width: 60rem) 20rem, 50vw" />
        <figcaption>The VIN fills in the vehicle.</figcaption>
      </figure>
      <figure>
        <Image src={approve} alt="Approve estimate dialog asking how the customer approved it, with an Approve and create work order button." widths={[480, 800]} sizes="(min-width: 60rem) 20rem, 50vw" />
        <figcaption>Approval records how the customer said yes.</figcaption>
      </figure>
      <figure>
        <Image src={invoice} alt="Create invoice dialog with odometer in and out, the invoice total, and Customer paid their share now ticked, with the method and a reference." widths={[480, 800]} sizes="(min-width: 60rem) 20rem, 50vw" />
        <figcaption>“Paid now”: the invoice records the customer’s share in the same step.</figcaption>
      </figure>
      <figure>
        <Image src={dropoff} alt="Vehicle at drop-off: odometer, exterior damage chips, mechanical concerns and warning lights." widths={[480, 800]} sizes="(min-width: 60rem) 20rem, 50vw" />
        <figcaption>Drop-off, mostly taps instead of typing.</figcaption>
      </figure>
      <figure>
        <Image src={payment} alt="Record payment dialog with the insurer chosen, the amount, cheque as the method, the date, and a reference field noting never to enter a full card number." widths={[480, 800]} sizes="(min-width: 60rem) 20rem, 50vw" />
        <figcaption>Payments keep a reference, never a full card number.</figcaption>
      </figure>
    </div>
  </section>

  <section class="chapter" id="quick">
    <span class="chapter-n">{n('quick')}</span>
    <h2>Quick sale</h2>
    <p class="insight">Small walk-in jobs, invoiced and paid in one tap.</p>
    <div class="prose">
      <p>
        Oil changes, alignments and the like don’t need an estimate. A quick sale takes the name, phone, plate, make
        and model, the work (saved items are one-tap buttons) and how they paid, then saves the customer, car,
        lines, invoice with HST and payment together. It goes through the usual approved, ready and invoiced
        steps, so numbering, totals and records match every other job, and nothing is saved if any part fails.
      </p>
      <p>
        <strong>Pay later.</strong> Friends and family often pay for small jobs later. A quick sale can be saved
        without a payment: it waits as “Owed”, with its own filter and total on the jobs list, and is invoiced on the
        day they actually pay. There’s no default, so every sale is either paid or deliberately left owing.
      </p>
    </div>
    <div class="shots shots-3">
      <ShotSlot
        file="613/desktop/14-quick-sale.png"
        alt="Quick sale form: name, phone, plate, make and model, saved-item buttons for the work, payment methods including Pay later, and a Paid · create invoice button."
        caption="A quick sale, start to paid."
        sizes="(min-width: 60rem) 20rem, 50vw"
      />
      <ShotSlot
        file="613/desktop/15-jobs-owed.png"
        alt="Jobs list grouped by day, with quick sales tagged Quick, an owed sale tagged Owed, and the Owed filter showing its count and total."
        caption="Owed sales wait under their own filter."
        sizes="(min-width: 60rem) 20rem, 50vw"
      />
      <ShotSlot
        file="613/desktop/16-saved-items-settings.png"
        alt="Settings, Saved items: each item with its lines and rough total, with up and down buttons, Edit, Duplicate and Remove."
        caption="The shop orders its own one-tap buttons."
        sizes="(min-width: 60rem) 20rem, 50vw"
      />
    </div>
  </section>

  <section class="chapter" id="bay">
    <span class="chapter-n">{n('bay')}</span>
    <h2>On a phone in the bay</h2>
    <p class="insight">Technicians don’t sit at the front desk.</p>
    <div class="prose">
      <p>
        On a phone, a job is one long page with a row of chips to jump between sections and big tap targets. The
        bar at the bottom shows the total and the next step: Approve, Mark ready, Invoice or Record payment.
      </p>
    </div>
    <div class="phones">
      {phones.map((p) => (
        <Image src={p.src} alt={p.alt} widths={[320, 480]} sizes="(min-width: 60rem) 11rem, 45vw" />
      ))}
      <ShotSlot
        file="613/phone/08-action-bar.png"
        alt="A job on a phone with the bottom bar showing three lines, the total and an Approve button."
        widths={[320, 480]}
        sizes="(min-width: 60rem) 11rem, 45vw"
      />
    </div>
  </section>

  <section class="chapter" id="documents">
    <span class="chapter-n">{n('documents')}</span>
    <h2>Four documents</h2>
    <p class="insight">Estimate, work order, invoice and inspection, all from the same data.</p>
    <div class="prose">
      <p>
        They print with jsPDF, in the brand I made from their logo: the “613” lettering traced from the JPEG, the
        stripes redrawn as clean shapes, Saira for headings and totals, and 613 yellow kept for the one thing that
        matters on each page.
      </p>
    </div>
    <div class="paper-row">
      {docs.map((d) => (
        <figure>
          <Image src={d.src} alt={d.alt} widths={[320, 640]} sizes="(min-width: 60rem) 13rem, 45vw" />
          <figcaption>{d.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="chapter" id="feedback">
    <span class="chapter-n">{n('feedback')}</span>
    <h2>What changed after feedback</h2>
    <p class="insight">Two weeks of live testing at the counter, and the app got shorter.</p>
    <ol class="changelog">
      <li>
        <span class="cap">27 Oct</span>
        <div>
          <p class="changelog-said">Starting a job meant creating the customer, coming back to add the vehicle, then creating the job.</p>
          <p>Check-in is now one screen and one save. New customers need only a name and a phone or email; the rest sits behind “More details”. While a job is an estimate, its page follows the counter’s order: concern, drop-off, photos, lines.</p>
        </div>
      </li>
      <li>
        <span class="cap">28 Oct</span>
        <div>
          <p class="changelog-said">Estimates and checkout needed to be faster.</p>
          <p>Saved items, copying the car’s last job, “Paid now” on the invoice, and the next step in the phone’s bottom bar.</p>
        </div>
      </li>
      <li>
        <span class="cap">29 Oct</span>
        <div>
          <p class="changelog-said">Pages needed to answer a tap faster.</p>
          <p>The app now runs in the same region as its database instead of across the continent, and every page shows a loading screen straight away.</p>
        </div>
      </li>
      <li>
        <span class="cap">31 Oct</span>
        <div>
          <p class="changelog-said">Walk-in jobs like oil changes don’t need an estimate, and friends and family often pay later.</p>
          <p>Quick sale, then Pay later and the Owed filter. Saved items got their own page in Settings, ordered by the shop, and the jobs list opens on everything, newest first.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="chapter" id="decisions">
    <span class="chapter-n">{n('decisions')}</span>
    <h2>Decisions</h2>
    <div class="decisions">
      <div class="decision">
        <h3>Money is worked out in one place</h3>
        <p>One module, in whole cents, works out every total. The job screen, the jobs list and the PDFs all call it, so they can’t disagree. Its tests include the shop’s own sample estimate.</p>
      </div>
      <div class="decision">
        <h3>The law is part of the workflow</h3>
        <p>Ontario wants a record of how an estimate was approved, a cap of 10% over it, and odometer readings on the invoice. The app asks for each at the moment it matters instead of leaving it to memory.</p>
      </div>
      <div class="decision">
        <h3>Database rules are tested, not assumed</h3>
        <p>The real migrations run in PGlite inside the test suite, so the row-level security that keeps data to the shop’s staff is checked on every change.</p>
      </div>
      <div class="decision">
        <h3>All or nothing at the counter</h3>
        <p>Check-in and quick sale each save through one database function. Customer, car, job, invoice and payment are written together or not at all, so a failed save never leaves half a customer or burns a job number.</p>
      </div>
      <div class="decision">
        <h3>A brand before an interface</h3>
        <p>The shop had a logo and nothing else. Making the colours, type and logo files first meant the app and the paperwork look like the same business.</p>
      </div>
    </div>
  </section>

  <section class="chapter" id="now">
    <span class="chapter-n">{n('now')}</span>
    <h2>Where it is now</h2>
    <dl class="outcome">
      <div class="field"><dt>Status</dt><dd>In live testing at the shop since October 2026</dd></div>
      <div class="field"><dt>Covers</dt><dd>Check-in to paid, quick sales, inspections, photos, four printed documents</dd></div>
      <div class="field"><dt>Next</dt><dd>Emailing documents to customers</dd></div>
    </dl>
  </section>

  <section class="chapter" id="reflection">
    <span class="chapter-n">{n('reflection')}</span>
    <h2>Reflection</h2>
    <div class="prose">
      <p>
        The request was an invoice generator. Most of the work turned out to be the parts around the invoice: the
        approval record, the drop-off photos, the 10% cap. Then live testing took steps away rather than adding
        them: three screens to start a job became one, and a walk-in oil change became one tap. Making the brand
        first felt like a detour at the time; it’s what makes the printed paperwork look like it belongs to the shop.
      </p>
    </div>
  </section>
</Case>

<style>
  .phones { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(0.5rem, 1.5vw, 1rem); align-items: start; }
  @media (max-width: 56rem) { .phones { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 36rem) { .phones { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
