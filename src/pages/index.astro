---
import BaseLayout from '../layouts/BaseLayout.astro';

const stack = [
  { label: 'Frontend', items: ['React', 'Next.js', 'TypeScript', 'Canvas API', 'Fabric.js'] },
  { label: 'Backend / Data', items: ['Node.js', 'Supabase', 'PostgreSQL'] },
  { label: 'Automation / AI', items: ['n8n', 'Claude API', 'Gemini API'] },
  { label: 'Deploy', items: ['Git', 'Netlify', 'Cloudflare'] },
];

const projects = [
  {
    name: 'Amplifier — AI Image Tagging System',
    type: 'AI / Full-stack',
    description: 'Design reference system pairing intelligent image tagging with automated client briefing generation. Features a self-learning feedback loop that sharpens tag accuracy over time.',
    tags: ['Next.js', 'React', 'Claude Vision API', 'Supabase', 'Canvas API'],
    link: '/projects/amplifier',
    linkText: 'Case study',
    external: false,
  },
  {
    name: 'Sacred Cosmos — Content Automation Platform',
    type: 'Automation / Full-stack',
    description: 'AI-powered content choreography platform — automated generation, visual canvas editor, and one-click Instagram/Facebook publishing.',
    tags: ['React', 'Fabric.js', 'n8n', 'Supabase', 'Gemini API', 'Netlify'],
    link: '/projects/content-automation',
    linkText: 'Case study',
    external: false,
  },
  {
    name: 'Francis — Art Director Portfolio',
    type: 'Freelance / Frontend',
    description: "Responsive portfolio built for an Art Director. Image-optimised and running on a zero-cost CMS — fast, maintainable, and entirely under the client's control.",
    tags: ['Next.js', 'Netlify CMS', 'Netlify'],
    link: 'https://francisdes.com',
    linkText: 'Visit site',
    external: true,
  },
  {
    name: 'Eldhose Kuriyan — Portfolio Rebuild',
    type: 'Freelance / Frontend',
    description: "Migrated a Framer site to vanilla JavaScript — same design fidelity, measurably better performance, and features the original couldn't support.",
    tags: ['JavaScript', 'HTML', 'CSS', 'Netlify'],
    link: 'https://eldhosekuriyan.com',
    linkText: 'Visit site',
    external: true,
  },
];
---

<BaseLayout title="Navaneeth Krishnan — Full-Stack Developer" page="home">

  <nav>
    <a href="/" class="nav-name">NK</a>
    <ul class="nav-links">
      <li><a href="#work">work</a></li>
      <li><a href="#about">about</a></li>
      <li><a href="#contact">contact</a></li>
    </ul>
  </nav>

  <section class="hero">
    <div class="hero-left">
      <h1 class="hero-name">Navaneeth<br>Krishnan</h1>
      <p class="hero-tagline">I build things that think.</p>
      <p class="hero-sub">Full-stack developer. Physics brain, anthropology lens. Based in Toronto.</p>
    </div>
    <div class="hero-right">
      <div class="status-pill">
        <span class="status-dot"></span>
        open to roles
      </div>
      <div class="hero-links">
        <a href="https://github.com/AliveOrdinary" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://linkedin.com/in/vrnavaneeth" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="mailto:vrnavaneeth135@gmail.com">vrnavaneeth135@gmail.com</a>
      </div>
    </div>
  </section>

  <div class="section-rule"></div>

  <section class="projects" id="work">
    <p class="section-label">Selected work</p>

    {projects.map((project, i) => (
      <div class="project-row">
        <span class="project-num">{String(i + 1).padStart(2, '0')}</span>
        <div class="project-body">
          <p class="project-type">{project.type}</p>
          <h2 class="project-name">{project.name}</h2>
          <p class="project-desc">{project.description}</p>
          <div class="project-stack">
            {project.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </div>
        <a
          class="project-link"
          href={project.link}
          {...(project.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {project.linkText} <span class="arrow">↗</span>
        </a>
      </div>
    ))}
  </section>

  <div class="section-rule"></div>

  <section class="about" id="about">
    <div>
      <p class="section-label">About</p>
      <p class="about-text">
        I came to web development through physics and anthropology — two disciplines that share a core habit: looking at how systems actually behave, not how they're supposed to.
      </p>
      <p class="about-text">
        That carries into how I build. I'm interested in <strong>automation that removes friction</strong>, <strong>AI integrations that do real work</strong>, and interfaces that respect the person using them.
      </p>
      <p class="about-text">
        Based in Toronto. 2+ years shipping production software. Available for full-time roles.
      </p>
    </div>
    <div class="stack-grid">
      <p class="section-label">Stack</p>
      {stack.map((group) => (
        <div>
          <p class="stack-row-label">{group.label}</p>
          <div class="stack-items">
            {group.items.map((item) => <span class="tag">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <div class="section-rule"></div>

  <section class="contact" id="contact">
    <h2 class="contact-heading">Got a problem<br>worth<br><span>solving?</span></h2>
    <div class="contact-right">
      <a href="mailto:vrnavaneeth135@gmail.com" class="contact-email">vrnavaneeth135@gmail.com</a>
      <div class="contact-socials">
        <a href="https://github.com/AliveOrdinary" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://linkedin.com/in/vrnavaneeth" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
  </section>

  <footer>
    <span>NAVANEETH KRISHNAN — TORONTO</span>
    <span>&copy; 2026</span>
  </footer>

</BaseLayout>
