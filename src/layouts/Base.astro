---
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'work';
}

const {
  title,
  description = 'Navaneeth Krishnan, full-stack developer in Toronto. I build software for the people doing the actual work.',
} = Astro.props;

// The footer's dithered band: a 4x4 Bayer matrix, denser toward the bottom edge.
const bayer = [
  [0, 8, 2, 10],
  [12, 4, 14, 6],
  [3, 11, 1, 9],
  [15, 7, 13, 5],
];
const CELL = 4;
const ROWS = 12;
let cells = '';
for (let r = 0; r < ROWS; r++) {
  const t = ((r + 0.5) / ROWS) ** 1.4;
  for (let c = 0; c < 4; c++) {
    if (bayer[r % 4][c] / 16 < t) cells += `<rect x='${c * CELL}' y='${r * CELL}' width='${CELL}' height='${CELL}'/>`;
  }
}
const dither = `url("data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' width='${4 * CELL}' height='${ROWS * CELL}' shape-rendering='crispEdges' fill='#b4b4b4'>${cells}</svg>`,
)}")`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#fbfbfb" />
    <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="wrap">
        <div class="masthead-row">
          <a href="/" class="wordmark" aria-label="Navaneeth Krishnan, home"><span>Navaneeth</span> <span>Krishnan</span></a>
          <p class="masthead-lede">
            Software for the people doing the actual work.
            <b>Full-stack developer, Toronto</b>
          </p>
        </div>
        <div class="glyphs" aria-hidden="true"></div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <p class="ornament" aria-hidden="true">***</p>
        <div class="foot-lines">
          <p><span class="pipe">|</span>Navaneeth Krishnan<span class="pipe">|</span>Full-stack developer<span class="pipe">|</span>Toronto, Ontario<span class="pipe">|</span></p>
          <p>
            <span class="pipe">|</span><a href="mailto:vrnavaneeth135@gmail.com">Email</a><span class="pipe">|</span><a href="/navaneeth-krishnan-resume.pdf">Résumé</a><span class="pipe">|</span><a href="https://github.com/AliveOrdinary" rel="noopener noreferrer">GitHub</a><span class="pipe">|</span><a href="https://linkedin.com/in/vrnavaneeth" rel="noopener noreferrer">LinkedIn</a><span class="pipe">|</span>
          </p>
          <p class="quiet">Set in EB Garamond and Departure Mono. Drawings by hand, in SVG.</p>
        </div>
      </div>
      <div class="dither" style={`background-image:${dither}`} aria-hidden="true"></div>
    </footer>
  </body>
</html>
