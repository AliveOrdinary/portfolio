---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/literata';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'work';
}

const {
  title,
  description = 'Navaneeth Krishnan, full-stack developer in Toronto. I build software for the people doing the actual work.',
  current = 'home',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#eef1e7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <!-- Ink filter for the stamp: roughens its edges like rubber on paper -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="ink" x="-5%" y="-10%" width="110%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.6" xChannelSelector="R" yChannelSelector="G" result="rough" />
        <feComponentTransfer in="noise" result="speckle">
          <feFuncA type="discrete" tableValues="1 1 1 1 1 1 0 1 1 1" />
        </feComponentTransfer>
        <feComposite in="rough" in2="speckle" operator="in" />
      </filter>
    </svg>

    <header class="site-head">
      <div class="wrap">
        <a href="/" class="mark" aria-label="Navaneeth Krishnan, home">Navaneeth Krishnan</a>
        <nav class="site-nav" aria-label="Main">
          <a href="/#work" aria-current={current === 'work' ? 'page' : undefined}>Work</a>
          <a href="/#how-i-work">How I work</a>
          <a href="/#tools">Tools</a>
          <a href="/#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <span>Navaneeth Krishnan, Toronto</span>
        <span class="foot-links">
          <a href="mailto:vrnavaneeth135@gmail.com">Email</a>
          <a href="/navaneeth-krishnan-resume.pdf">Résumé</a>
          <a href="https://github.com/AliveOrdinary" rel="noopener noreferrer">GitHub</a>
          <a href="https://linkedin.com/in/vrnavaneeth" rel="noopener noreferrer">LinkedIn</a>
        </span>
      </div>
    </footer>
  </body>
</html>
